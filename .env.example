# ============================================================
# ProjectFlow — Environment Variable Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── Application ─────────────────────────────────────────────
APP_ENV=development          # development | test | production
APP_NAME=ProjectFlow
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR

# ── Backend Server ──────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=1            # increase in production

# ── Database ────────────────────────────────────────────────
# Async URL used by the application (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://projectflow:projectflow@localhost:5432/projectflow
# Sync URL used by Alembic migrations (psycopg2 driver)
DATABASE_SYNC_URL=postgresql+psycopg2://projectflow:projectflow@localhost:5432/projectflow
# Connection pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Test database (used by pytest integration/api tests)
TEST_DATABASE_URL=postgresql+asyncpg://projectflow:projectflow@localhost:5432/projectflow_test
TEST_DATABASE_SYNC_URL=postgresql+psycopg2://projectflow:projectflow@localhost:5432/projectflow_test

# ── JWT Authentication ───────────────────────────────────────
JWT_SECRET_KEY=dev-jwt-secret-key-projectflow-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── CORS ────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Security ────────────────────────────────────────────────
# Internal API key for service-to-service calls (optional)
INTERNAL_API_KEY=change-me-in-production

# ── Frontend ────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000

# ── Rate Limiting (future) ───────────────────────────────────
# RATE_LIMIT_PER_MINUTE=60

# ── PostgreSQL Docker ────────────────────────────────────────
# These are only used by docker-compose; app uses DATABASE_URL above
POSTGRES_USER=projectflow
POSTGRES_PASSWORD=projectflow
POSTGRES_DB=projectflow
POSTGRES_PORT=5432
